# Copy to .env (git ignores it) and fill in. `npm start` loads it automatically.
# On Vercel, set the same variable under Project Settings -> Environment Variables.

# Google Maps Platform key for the Google Satellite basemap + Street View.
# Used in the browser, so restrict it in Google Cloud (website referrers + APIs:
# Map Tiles API, Maps JavaScript API, Street View Static API).
GOOGLE_MAPS_API_KEY=
